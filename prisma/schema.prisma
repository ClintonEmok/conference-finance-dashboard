generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum TicketTailorWebhookStatus {
  pending
  processed
  failed
}

enum TicketTailorOrderStatus {
  paid
  refunded
  cancelled
  pending
}

enum TicketTailorSyncOutcome {
  running
  success
  partial
  failed
}

enum TikkiePaymentLinkStatus {
  created
  paid
  expired
}

enum TikkiePaymentLinkStatusSource {
  create
  webhook
  poll
}

enum AllocationPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum GenderType {
  MALE
  FEMALE
  MIXED
  UNKNOWN
}

enum RoomAllocationStatus {
  proposed
  confirmed
  rejected
}

model TicketTailorWebhookEvent {
  id               String                   @id @default(cuid())
  providerEventId  String                   @unique
  eventType        String
  payload          Json
  canonicalPayload Json?
  status           TicketTailorWebhookStatus @default(pending)
  deliveryCount    Int                      @default(1)
  attempts         Int                      @default(0)
  lastError        String?
  nextRetryAt      DateTime?
  canonicalFetchedAt DateTime?
  processedAt      DateTime?
  receivedAt       DateTime                 @default(now())
  lastReceivedAt   DateTime                 @default(now())

  @@index([status, nextRetryAt])
  @@index([eventType])
}

model TicketTailorEvent {
  id                String             @id @default(cuid())
  providerEventId   String             @unique
  name              String?
  startsAt          DateTime?
  endsAt            DateTime?
  timezone          String?
  currency          String?
  rawPayload        Json
  attendees         TicketTailorAttendee[]
  accommodationHotels AccommodationEventHotel[]
  orders            TicketTailorOrder[]
  tikkieTemplates   TikkiePaymentTemplate[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([startsAt])
}

model TicketTailorOrder {
  id                    String                  @id @default(cuid())
  providerOrderId       String                  @unique
  providerEventId       String
  eventId               String
  event                 TicketTailorEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendees             TicketTailorAttendee[]
  normalizedStatus      TicketTailorOrderStatus @default(pending)
  providerStatus        String?
  normalizationNote     String?
  buyerEmail            String?
  buyerName             String?
  currency              String?
  totalAmountMinor      Int?
  orderedAt             DateTime?
  refundedAt            DateTime?
  cancelledAt           DateTime?
  rawPayload            Json
  tikkiePaymentLinks    TikkiePaymentLink[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([eventId])
  @@index([orderedAt])
  @@index([normalizedStatus])
}

model TicketTailorAttendee {
  id                      String             @id @default(cuid())
  providerAttendeeId      String?            @unique
  providerIssuedTicketId  String?            @unique
  providerTicketTypeId    String?
  providerEventId         String
  providerOrderId         String
  eventId                 String
  orderId                 String
  assignedRoomId          String?
  event                   TicketTailorEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order                   TicketTailorOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedRoom            AccommodationRoom? @relation(fields: [assignedRoomId], references: [id], onDelete: SetNull)
  name                    String?
  email                   String?
  ticketTypeLabel         String?
  ticketStatus            String?
  checkedInAt             DateTime?
  rawPayload              Json
  customAnswers           Json?
  genderType              GenderType?
  ageGroup                String?
  ticketCategory          String?
  allocationPriority      AllocationPriority @default(NORMAL)
  priorityReason          String?
  tikkieAmountOverrideMinor Int?
  familyGroupMember       AttendeeFamilyMember?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([eventId])
  @@index([orderId])
  @@index([assignedRoomId])
  @@index([providerEventId, providerOrderId])
  @@index([email])
  @@index([genderType])
  @@index([allocationPriority])
}

model AccommodationHotel {
  id        String              @id @default(cuid())
  name      String              @unique
  city      String?
  notes     String?
   eventLinks AccommodationEventHotel[]
  rooms     AccommodationRoom[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model AccommodationEventHotel {
  id        String             @id @default(cuid())
  eventId    String
  hotelId    String
  event      TicketTailorEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hotel      AccommodationHotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@unique([eventId, hotelId])
  @@index([hotelId])
}

model TikkiePaymentTemplate {
  id                  String      @id @default(cuid())
  eventId             String
  event               TicketTailorEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypeLabel     String
  amountMinor         Int
  descriptionTemplate String
  expiryDays          Int         @default(14)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([eventId, ticketTypeLabel])
  @@index([eventId])
}

model AccommodationRoomType {
  id              String              @id @default(cuid())
  label           String              @unique
  defaultCapacity Int
  notes           String?
  rooms           AccommodationRoom[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model AccommodationRoom {
  id           String                @id @default(cuid())
  hotelId      String
  roomTypeId   String
  label        String
  capacity     Int
  occupiedBeds Int                   @default(0)
  notes        String?
  hotel        AccommodationHotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType     AccommodationRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  attendees    TicketTailorAttendee[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([hotelId, label])
  @@index([roomTypeId])
  @@index([hotelId, capacity])
}

model TikkiePaymentLink {
  id                    String                        @id @default(cuid())
  providerOrderId       String
  providerEventId       String
  orderId               String
  order                 TicketTailorOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentRequestToken   String                        @unique
  paymentRequestUrl     String
  status                TikkiePaymentLinkStatus       @default(created)
  statusSource          TikkiePaymentLinkStatusSource @default(create)
  providerStatus        String
  amountMinor           Int
  description           String
  expiryDate            DateTime
  referenceId           String?
  providerPayload       Json
  providerLastCheckedAt DateTime?
  statusUpdatedAt       DateTime                      @default(now())
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  transitionEvents      TikkiePaymentLinkTransition[]

  @@index([providerOrderId, providerEventId])
  @@index([status, statusUpdatedAt])
}

model TikkiePaymentLinkTransition {
  id             String                        @id @default(cuid())
  paymentLinkId  String
  paymentLink    TikkiePaymentLink             @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)
  fromStatus     TikkiePaymentLinkStatus
  toStatus       TikkiePaymentLinkStatus
  source         TikkiePaymentLinkStatusSource
  providerNotificationKey String?              @unique
  providerStatus String
  reason         String?
  providerPayload Json?
  createdAt      DateTime                      @default(now())

  @@index([paymentLinkId, createdAt])
}

model TicketTailorSyncRun {
  id                      String                  @id @default(cuid())
  status                  TicketTailorSyncOutcome @default(running)
  startedAt               DateTime                @default(now())
  finishedAt              DateTime?
  eventsScanned           Int                     @default(0)
  ordersFetched           Int                     @default(0)
  ordersUpserted          Int                     @default(0)
  normalizedFallbackCount Int                     @default(0)
  failedItems             Int                     @default(0)
  errorSummary            String?
  diagnostics             Json?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([startedAt])
}

model AttendeeFamilyGroup {
  id                    String   @id @default(cuid())
  label                 String?
  primaryAttendeeId     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  members               AttendeeFamilyMember[]

  @@index([primaryAttendeeId])
}

model AttendeeFamilyMember {
  id              String            @id @default(cuid())
  familyGroupId   String
  familyGroup     AttendeeFamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  attendeeId      String            @unique
  attendee        TicketTailorAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  relationship    String?
  createdAt       DateTime          @default(now())

  @@index([familyGroupId])
}

enum PaymentSource {
  tikkie
  bank_transfer
  cash
}

enum PaymentMatchStatus {
  auto_matched
  manual_assignment
  ambiguous
  unassigned
}

model Payment {
  id                    String             @id @default(cuid())
  source                PaymentSource
  sourceId              String?            // Tikkie: payment ID, Bank/Cash: internal

  // Payer info (from payment)
  payerName             String
  payerAccountNumber    String?

  // Amount
  amountMinor          Int
  paidAt               DateTime

  // Linkage
  orderId              String?
  status               PaymentMatchStatus @default(unassigned)
  matchedAt            DateTime?
  matchedBy            String?            // 'auto' or user ID

  // Manual entry specifics
  reference            String?            // Bank transfer reference
  notes                String?

  // Source data preservation
  providerPayload       Json?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([orderId])
  @@index([source, sourceId])
  @@index([status])
}

model RoomAllocation {
  id        String              @id @default(cuid())
  eventId   String
  roomId    String
  status    RoomAllocationStatus @default(proposed)
  notes     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([eventId, roomId])
  @@index([eventId, status])
}
