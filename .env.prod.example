# App
NODE_ENV=production
APP_URL="https://your-domain.com"

# Supabase Configuration
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?schema=public&pool_timeout=10"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Email
MAGIC_LINK_FROM_EMAIL="finance@your-domain.com"

# Ticket Tailor
TICKET_TAILOR_API_KEY="YOUR_TICKET_TAILOR_API_KEY"
TICKET_TAILOR_BASE_URL="https://api.tickettailor.com"

# Tikkie
TIKKIE_API_KEY="YOUR_TIKKIE_API_KEY"
TIKKIE_APP_TOKEN="YOUR_TIKKIE_APP_TOKEN"
TIKKIE_BASE_URL="https://api.tikkie.me"
TIKKIE_WEBHOOK_SECRET="YOUR_TIKKIE_WEBHOOK_SECRET"
TIKKIE_SYNC_CRON_SECRET="YOUR_TIKKIE_SYNC_CRON_SECRET"
TIKKIE_SUBSCRIPTION_SETUP_ENABLED="false"
TIKKIE_WEBHOOK_CALLBACK_URL="https://your-domain.com/api/webhooks/tikkie"

# Integration health checks
INTEGRATION_PING_TIMEOUT_MS="5000"

# Clerk (production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxx"
CLERK_JWT_ISSUER_DOMAIN="https://your-clerk-instance.clerk.accounts.dev"

# Convex (production)
NEXT_PUBLIC_CONVEX_URL="https://your-convex-deployment.convex.cloud"

# Note:
# Do not set NEXT_PUBLIC_CONVEX_SITE_URL for app runtime queries/mutations.
# .convex.site is for Convex HTTP actions/webhooks only.
