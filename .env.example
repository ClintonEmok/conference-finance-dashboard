# App
NODE_ENV=development
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Supabase Configuration
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Better Auth (deprecated - using Supabase Auth)
# BETTER_AUTH_URL="http://localhost:3000"
# BETTER_AUTH_SECRET="replace-with-32-plus-char-secret"
MAGIC_LINK_FROM_EMAIL="finance@example.org"

# Ticket Tailor
TICKET_TAILOR_API_KEY=""
TICKET_TAILOR_BASE_URL="https://api.tickettailor.com/v1"

# Tikkie
TIKKIE_API_KEY=""
TIKKIE_APP_TOKEN=""
TIKKIE_BASE_URL="https://api.tikkie.me"
TIKKIE_WEBHOOK_SECRET=""
TIKKIE_SYNC_CRON_SECRET=""
# Subscription setup (disabled by default - enable only when ready to configure webhook notifications)
TIKKIE_SUBSCRIPTION_SETUP_ENABLED="false"
TIKKIE_WEBHOOK_CALLBACK_URL=""

# Integration health checks
INTEGRATION_PING_TIMEOUT_MS="5000"

# Resend Email (via @convex-dev/resend component)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
RESEND_FROM_NAME="Conference Finance"
RESEND_WEBHOOK_SECRET= # Optional: for delivery tracking
